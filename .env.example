# Copy to .env and fill in. `npm run server` loads it automatically.

# --- Email (verification + password reset) -----------------------------------
# Without SMTP_HOST, emails aren't sent: links are printed to the API console.
# Gmail: smtp.gmail.com, port 465, your address, and an App Password
# (Google Account → Security → 2-Step Verification → App passwords).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="OGod <no-reply@example.com>"

# Public address of the app, used in emailed links. Required in production.
OGOD_APP_URL=

# --- Google sign-in -----------------------------------------------------------
# OAuth 2.0 Client ID (type "Web application") from Google Cloud Console.
GOOGLE_CLIENT_ID=

# --- Server -------------------------------------------------------------------
# OGOD_JWT_SECRET=
# OGOD_TRUST_PROXY=1
# Only needed when the frontend is served from a different origin than the API.
# OGOD_CORS_ORIGIN=https://app.example.com
